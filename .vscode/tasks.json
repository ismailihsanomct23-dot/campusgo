{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start CampusGo PHP Server",
      "type": "shell",
      "command": "php",
      "args": ["-S", "0.0.0.0:8000", "-t", "backend"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Listening on.*",
          "endsPattern": "^.*$"
        }
      }
    }
  ]
}
